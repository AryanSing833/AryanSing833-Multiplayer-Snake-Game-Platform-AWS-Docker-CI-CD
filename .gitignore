# ──────────────────────────────────────────────
# Node / npm
# ──────────────────────────────────────────────
node_modules/
client/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json        # remove this line if you DO want to commit lock files
client/package-lock.json # same as above

# ──────────────────────────────────────────────
# Build output
# ──────────────────────────────────────────────
client/dist/
client/build/
dist/
build/

# ──────────────────────────────────────────────
# Environment variables  ← NEVER commit these
# ──────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env.local
client/.env.*.local

# ──────────────────────────────────────────────
# SSL / private keys  ← NEVER commit these
# ──────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
logs/
*.log

# ──────────────────────────────────────────────
# OS generated files
# ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ──────────────────────────────────────────────
# IDE / Editor
# ──────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ──────────────────────────────────────────────
# Vite / React cache
# ──────────────────────────────────────────────
client/.vite/
client/node_modules/.vite/
.eslintcache

# ──────────────────────────────────────────────
# Testing
# ──────────────────────────────────────────────
coverage/
client/coverage/
.nyc_output/

# ──────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────
.dockerignore
